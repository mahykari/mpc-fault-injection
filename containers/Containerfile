# Build a patched mascot-party.x (and any other party binaries we add later)
# from MP-SPDZ v0.4.2 source. Builds inside ubuntu:22.04 because Ubuntu
# 26.04 host has Boost 1.90, which is incompatible with libOTe's ASIO usage.
#
# Driven by containers/build.sh, which extracts the binary into
# MP-SPDZ/bin/Linux-amd64-patched/ on the host.

FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      automake \
      build-essential \
      ca-certificates \
      clang-11 \
      cmake \
      curl \
      git \
      libboost-dev \
      libboost-thread-dev \
      libclang-dev \
      libgmp-dev \
      libntl-dev \
      libsodium-dev \
      libssl-dev \
      libtool \
      m4 \
      patch \
      python3 \
      xz-utils \
      yasm \
      zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN curl -fsSL -o mp-spdz.tar.xz \
      https://github.com/data61/MP-SPDZ/releases/download/v0.4.2/mp-spdz-0.4.2.tar.xz \
 && tar -xJf mp-spdz.tar.xz \
 && rm mp-spdz.tar.xz

WORKDIR /src/mp-spdz-0.4.2

# Apply our patches in numbered order. The base patch set always applies;
# the seeded-bug overlay (extra patches) only applies when APPLY_SEEDED_BUG=1.
ARG APPLY_SEEDED_BUG=0
COPY patches/mpspdz/*.patch /patches/base/
COPY patches/mpspdz-seeded-bug/ /patches/seeded-bug/
RUN for p in /patches/base/*.patch; do \
        echo "Applying $(basename $p)"; patch -p1 < "$p"; \
    done && \
    if [ "$APPLY_SEEDED_BUG" = "1" ]; then \
      for p in /patches/seeded-bug/*.patch; do \
        echo "Applying (seeded-bug) $(basename $p)"; patch -p1 < "$p"; \
      done; \
    fi

# Match upstream Dockerfile's CONFIG.mine defaults.
RUN echo "CXX = clang++-11"                                              >> CONFIG.mine \
 && echo "USE_NTL = 0"                                                    >> CONFIG.mine \
 && echo "MY_CFLAGS += -I/usr/local/include"                              >> CONFIG.mine \
 && echo "MY_LDLIBS += -Wl,-rpath -Wl,/usr/local/lib -L/usr/local/lib"   >> CONFIG.mine

# 2 players matches the harness's n=2 default. setup-ssl.sh just writes
# placeholder cert/key pairs into Player-Data/; runtime reads them.
RUN ./Scripts/setup-ssl.sh 2 Player-Data

# Build libOTe's pinned Boost + libOTe, then static/mascot-party.x.
# The plain `mascot-party.x` target links against libSPDZ.so + the in-container
# Boost 1.83 and won't run on the host; the `static/mascot-party.x` target
# (Makefile line 154) static-links Boost + libstdc++, leaving only
# libc/libdl/libm/libpthread dynamic — matches the stock binary at
# MP-SPDZ/bin/Linux-amd64/mascot-party.x.
RUN make clean-deps boost libote
RUN make -j"$(nproc)" static/mascot-party.x

RUN ls -la static/mascot-party.x && file static/mascot-party.x

# ─────────────────────────────────────────────────────────────────────────────
# runtime: the full fuzz pipeline. Layers uv + this repo onto `builder`, which
# already carries the MP-SPDZ Compiler module and the freshly-built party
# binary — no second MP-SPDZ fetch. Entrypoint runs main.py; the host launcher
# overrides INSTANCE_ID / SEEDS per instance (see containers/run-parallel.sh).
# ─────────────────────────────────────────────────────────────────────────────
FROM builder AS runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      openssh-client \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Shape an MP-SPDZ root that Config's paths resolve against: Compiler/ is
# already at /src/mp-spdz-0.4.2; expose the static binary where
# `Config.party_binary_path` (Linux-amd64-patched, use_patched_binary=True)
# looks for it.
RUN mkdir -p /src/mp-spdz-0.4.2/bin/Linux-amd64-patched \
 && ln -s /src/mp-spdz-0.4.2/static/mascot-party.x \
          /src/mp-spdz-0.4.2/bin/Linux-amd64-patched/mascot-party.x

WORKDIR /app
RUN ln -s /src/mp-spdz-0.4.2 /app/MP-SPDZ && mkdir -p /app/runs

# python-circil is a private repo; clone it at the pinned commit using SSH-agent
# forwarding. Requires `podman build --ssh default` with the key loaded.
ARG CIRCIL_REF=674504187083701857b6fb4d2741c316aa5ce451
RUN --mount=type=ssh \
    mkdir -p -m 0700 ~/.ssh && ssh-keyscan github.com >> ~/.ssh/known_hosts \
 && git clone git@github.com:Rigorous-Software-Engineering/python-circil.git \
      /app/python-circil \
 && git -C /app/python-circil checkout "$CIRCIL_REF"

COPY pyproject.toml uv.lock main.py /app/
COPY pipeline/ /app/pipeline/
RUN uv sync --frozen

ENTRYPOINT ["uv", "run", "python", "main.py"]
