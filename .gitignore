.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/contractor
.claude/.turn-start
.claude/guess.md
.claude/memory/*.bak/

# Local-only Claude Code notes and per-task briefings (copied into each
# worktree via .worktreeinclude). Not for git history.
CLAUDE.local.md
briefings/

# local scratch / worktree setup
prop.txt
.worktreeinclude
