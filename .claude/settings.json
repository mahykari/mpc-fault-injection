{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/librarian.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/edit-gate.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "contractor",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/contractor-start.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "contractor",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/contractor-stop.sh"
          }
        ]
      }
    ]
  }
}
